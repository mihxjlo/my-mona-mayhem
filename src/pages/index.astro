---
const title = 'Mona Mayhem - GitHub Contribution Battle Arena';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Compare GitHub contribution totals in a friendly battle." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="crt-overlay" aria-hidden="true"></div>
    <main class="arena">
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow">Mona Mayhem</p>
        <h1 id="page-title">GitHub Contribution Battle Arena</h1>
        <p>Enter two GitHub usernames to see who made the biggest contribution impact.</p>
      </section>

      <form id="battle-form" class="battle-form">
        <div class="players">
          <label class="player-field player-field-one">
            <span>Player 1</span>
            <input
              id="player-one"
              name="playerOne"
              type="text"
              placeholder="octocat"
              autocomplete="off"
              maxlength="39"
              required
            />
          </label>

          <span class="versus" aria-hidden="true">VS</span>

          <label class="player-field player-field-two">
            <span>Player 2</span>
            <input
              id="player-two"
              name="playerTwo"
              type="text"
              placeholder="torvalds"
              autocomplete="off"
              maxlength="39"
              required
            />
          </label>
        </div>

        <button id="battle-button" type="submit">Battle</button>
      </form>

      <p id="battle-status" class="status" role="status" aria-live="polite"></p>

      <section id="results" class="results" aria-labelledby="results-title" hidden>
        <h2 id="results-title">Battle results</h2>
        <div class="result-grid">
          <article
            id="player-one-result"
            class="result-card"
          >
            <div class="card-inner">
              <div class="card-face card-front">
                <h3></h3>
                <p><strong class="total"></strong> contributions</p>
                <p class="date-range"></p>
              </div>
              <div class="card-face card-back">
                <p class="graph-title">Contribution graph</p>
                <div class="contribution-grid" aria-label="Player 1 contribution graph"></div>
              </div>
            </div>
          </article>
          <div class="results-versus" aria-hidden="true">VS</div>
          <article
            id="player-two-result"
            class="result-card"
          >
            <div class="card-inner">
              <div class="card-face card-front">
                <h3></h3>
                <p><strong class="total"></strong> contributions</p>
                <p class="date-range"></p>
              </div>
              <div class="card-face card-back">
                <p class="graph-title">Contribution graph</p>
                <div class="contribution-grid" aria-label="Player 2 contribution graph"></div>
              </div>
            </div>
          </article>
        </div>
        <p id="winner" class="winner"></p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    --arcade-bg: #0a0a1a;
    --arcade-panel: #11112a;
    --arcade-panel-bright: #17173a;
    --arcade-green: #5fed83;
    --arcade-purple: #8a2be2;
    --arcade-text: #f2f2ff;
    --arcade-muted: #a4a4c2;
    --arcade-border: rgb(95 237 131 / 42%);
    margin: 0;
    color: var(--arcade-text);
    background: var(--arcade-bg);
    font-family:
      "Press Start 2P", "Courier New", monospace;
    overflow-x: hidden;
  }

  :global(body::before) {
    position: fixed;
    z-index: -2;
    inset: 0;
    background:
      radial-gradient(circle at 50% 0%, rgb(138 43 226 / 16%), transparent 35rem),
      radial-gradient(circle at 50% 100%, rgb(95 237 131 / 10%), transparent 30rem),
      var(--arcade-bg);
    content: "";
  }

  :global(body::after) {
    position: fixed;
    z-index: -1;
    inset: 0;
    box-shadow: inset 0 0 10rem rgb(0 0 0 / 65%);
    content: "";
    pointer-events: none;
  }

  .crt-overlay {
    position: fixed;
    z-index: 10;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 0.18rem,
      rgb(0 0 0 / 14%) 0.2rem,
      rgb(0 0 0 / 14%) 0.24rem
    );
    opacity: 0.45;
    pointer-events: none;
  }

  .arena {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 64rem);
    margin: 0 auto;
    padding: 4rem 0 5rem;
  }

  .intro {
    max-width: 38rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--arcade-green);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow:
      0 0 0.4rem var(--arcade-green),
      0 0 1.2rem rgb(95 237 131 / 75%);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    color: var(--arcade-text);
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.05;
    text-shadow:
      0 0 0.35rem var(--arcade-text),
      0 0 1rem var(--arcade-green),
      0 0 2.2rem var(--arcade-purple);
    animation: neon-pulse 2.8s ease-in-out infinite;
  }

  .intro p:last-child {
    margin-bottom: 0;
    color: var(--arcade-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .battle-form,
  .results {
    padding: 1.5rem;
    border: 1px solid var(--arcade-border);
    border-radius: 0.75rem;
    background: linear-gradient(145deg, var(--arcade-panel-bright), var(--arcade-panel));
    box-shadow:
      0 0 1.2rem rgb(95 237 131 / 12%),
      inset 0 0 1.2rem rgb(138 43 226 / 8%);
  }

  .players {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: end;
  }

  .player-field {
    display: grid;
    gap: 0.5rem;
    color: var(--arcade-green);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    animation: float-in 0.7s ease-out both;
  }

  .player-field-two {
    animation-delay: 0.15s;
  }

  input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid rgb(138 43 226 / 72%);
    border-radius: 0.4rem;
    color: var(--arcade-text);
    background: #080818;
    font: inherit;
    font-size: 0.75rem;
  }

  input:focus,
  button:focus-visible {
    outline: 3px solid rgb(95 237 131 / 55%);
    outline-offset: 2px;
  }

  .versus {
    padding-bottom: 0.75rem;
    color: var(--arcade-purple);
    font-size: 0.85rem;
    font-weight: 800;
    text-shadow: 0 0 0.7rem var(--arcade-purple);
  }

  button {
    display: block;
    min-width: 8rem;
    margin: 1.5rem auto 0;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--arcade-green);
    border-radius: 0.4rem;
    color: var(--arcade-bg);
    background: var(--arcade-green);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    box-shadow: 0 0 1rem rgb(95 237 131 / 55%);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  button:hover:not(:disabled) {
    background: #8aff9f;
    box-shadow:
      0 0 1rem var(--arcade-green),
      0 0 2rem rgb(138 43 226 / 65%);
    transform: translateY(-2px);
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .status {
    min-height: 1.5rem;
    margin: 1rem 0;
    color: var(--arcade-muted);
    text-align: center;
    line-height: 1.8;
  }

  .status.loading {
    color: var(--arcade-green);
    animation: loading-shift 1.2s ease-in-out infinite alternate;
  }

  .status.error {
    color: #ff6b8a;
  }

  .results h2 {
    margin-bottom: 1rem;
    color: var(--arcade-green);
    font-size: 1.25rem;
    text-shadow: 0 0 0.6rem rgb(95 237 131 / 65%);
  }

  .result-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .result-card {
    position: relative;
    min-width: 0;
    min-height: 15rem;
    overflow: hidden;
    border: 1px solid rgb(138 43 226 / 68%);
    border-radius: 0.5rem;
    text-align: center;
    cursor: pointer;
    perspective: 1000px;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .result-card:hover {
    border-color: var(--arcade-green);
    box-shadow:
      0 0.65rem 1rem rgb(0 0 0 / 35%),
      0 0 1.2rem rgb(95 237 131 / 28%);
    animation: card-hover 0.55s ease-in-out infinite;
  }

  .card-inner {
    position: relative;
    width: 100%;
    min-height: 15rem;
    transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-style: preserve-3d;
  }

  .result-card.card-flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem;
    border-radius: 0.5rem;
    background: rgb(10 10 26 / 72%);
    backface-visibility: hidden;
  }

  .card-back {
    overflow: hidden;
    padding: 1rem 0 0;
    transform: rotateY(180deg);
  }

  .result-card::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 35%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 28%), transparent);
    content: "";
    pointer-events: none;
    transform: skewX(-18deg);
  }

  .results:not([hidden]) .result-card::after {
    animation: card-shimmer 1.2s ease-out 0.4s 1 normal none;
  }

  .result-card h3 {
    margin-bottom: 0.5rem;
    overflow-wrap: anywhere;
    color: var(--arcade-text);
    text-shadow: 0 0 0.5rem var(--arcade-purple);
  }

  .result-card p {
    margin-bottom: 0;
    color: var(--arcade-muted);
  }

  .date-range {
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  .result-card .total {
    color: #24292f;
    font-size: 1.5rem;
  }

  .results-versus {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 3px solid #8250df;
    border-radius: 50%;
    border-color: var(--arcade-green);
    color: var(--arcade-text);
    background: linear-gradient(135deg, var(--arcade-green), var(--arcade-purple), var(--arcade-green));
    background-size: 220% 220%;
    font-size: 0.8rem;
    font-weight: 800;
    box-shadow:
      0 0 0.8rem var(--arcade-green),
      0 0 1.5rem rgb(138 43 226 / 70%);
    animation: badge-gradient 3s ease-in-out infinite;
  }

  .contribution-grid {
    display: grid;
    grid-template-columns: repeat(var(--week-count, 53), minmax(0, 1fr));
    grid-template-rows: 4.8rem;
    gap: 0.2rem;
    width: 100%;
    margin: 0;
    overflow: hidden;
    padding: 0 1rem 1rem;
  }

  .card-back .contribution-grid {
    flex: 0 0 auto;
    min-height: 0;
    align-content: start;
  }

  .graph-title {
    margin-bottom: 1rem;
    padding: 0 1rem;
    color: var(--arcade-green);
    font-size: 0.7rem;
    text-shadow: 0 0 0.5rem var(--arcade-green);
  }

  :global(.contribution-week) {
    display: grid;
    grid-template-rows: repeat(7, minmax(0, 1fr));
    gap: 0.2rem;
    height: 4.8rem;
    min-width: 0;
  }

  :global(.contribution-day) {
    width: 100%;
    max-width: none;
    aspect-ratio: 1;
    height: auto;
    border-radius: 0.15rem;
    background: #ebedf0;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  :global(.contribution-day:hover),
  :global(.contribution-day:focus-visible) {
    position: relative;
    z-index: 1;
    outline: none;
    transform: scale(1.7);
    box-shadow:
      0 0 0.45rem var(--arcade-green),
      0 0 0.9rem var(--arcade-purple);
  }

  :global(.contribution-day[data-level="1"]) {
    background: #9be9a8;
  }

  :global(.contribution-day[data-level="2"]) {
    background: #40c463;
  }

  :global(.contribution-day[data-level="3"]) {
    background: #30a14e;
  }

  :global(.contribution-day[data-level="4"]) {
    background: #216e39;
  }

  .result-card.winner {
    border-color: var(--arcade-green);
    background: linear-gradient(145deg, rgb(95 237 131 / 15%), var(--arcade-panel));
    box-shadow:
      0 0 1rem rgb(95 237 131 / 42%),
      inset 0 0 1rem rgb(95 237 131 / 10%);
  }

  .winner {
    margin: 1.5rem 0 0;
    color: var(--arcade-green);
    font-size: 1.25rem;
    font-weight: 700;
    text-align: center;
    text-shadow: 0 0 0.7rem var(--arcade-green);
  }

  @keyframes neon-pulse {
    0%,
    100% {
      filter: brightness(0.92);
      text-shadow:
        0 0 0.35rem var(--arcade-text),
        0 0 1rem var(--arcade-green),
        0 0 2.2rem var(--arcade-purple);
    }

    50% {
      filter: brightness(1.15);
      text-shadow:
        0 0 0.5rem var(--arcade-text),
        0 0 1.6rem var(--arcade-green),
        0 0 3.4rem var(--arcade-purple);
    }
  }

  @keyframes badge-gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes card-shimmer {
    from {
      left: -60%;
    }

    to {
      left: 130%;
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes loading-shift {
    from {
      color: var(--arcade-green);
      text-shadow: 0 0 0.5rem var(--arcade-green);
    }

    to {
      color: var(--arcade-purple);
      text-shadow: 0 0 0.8rem var(--arcade-purple);
    }
  }

  @keyframes card-hover {
    0% {
      transform: translateY(0) rotate(0);
    }

    25% {
      transform: translateY(-4px) rotate(-0.35deg);
    }

    50% {
      transform: translateY(-6px) rotate(0.35deg);
    }

    75% {
      transform: translateY(-4px) rotate(-0.2deg);
    }

    100% {
      transform: translateY(-3px) rotate(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 40rem) {
    .players,
    .result-grid {
      grid-template-columns: 1fr;
    }

    .versus {
      padding: 0;
      text-align: center;
    }

    .results-versus {
      justify-self: center;
    }
  }
</style>

<script>
  interface ContributionDay {
    weekday: number;
    date?: string;
    count: number;
    level: number;
  }

  interface ContributionWeek {
    index: number;
    first_day: string;
    contribution_days: ContributionDay[];
  }

  interface ContributionData {
    from: string;
    to: string;
    total_contributions: number;
    weeks: ContributionWeek[];
  }

  interface ContributionApiError {
    error?: {
      message?: string;
    };
  }

  const form = document.querySelector('#battle-form');
  const button = document.querySelector('#battle-button');
  const status = document.querySelector('#battle-status');
  const results = document.querySelector('#results');
  const winner = document.querySelector('#winner');

  if (
    form instanceof HTMLFormElement &&
    button instanceof HTMLButtonElement &&
    status instanceof HTMLElement &&
    results instanceof HTMLElement &&
    winner instanceof HTMLElement
  ) {
    const contributionDataByCard = new WeakMap<HTMLElement, ContributionData>();

    form.querySelectorAll('input').forEach((input) => {
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          form.requestSubmit();
        }
      });
    });

    const formatDate = (date: string): string =>
      new Date(`${date}T00:00:00`).toLocaleDateString(undefined, {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });

    const isContributionData = (data: unknown): data is ContributionData => {
      if (typeof data !== 'object' || data === null) {
        return false;
      }

      const contributionData = data as Partial<ContributionData>;
      return (
        typeof contributionData.from === 'string' &&
        typeof contributionData.to === 'string' &&
        typeof contributionData.total_contributions === 'number' &&
        Array.isArray(contributionData.weeks)
      );
    };

    const getApiError = (data: unknown): string => {
      if (typeof data === 'object' && data !== null) {
        const apiError = data as ContributionApiError;

        if (typeof apiError.error?.message === 'string') {
          return apiError.error.message;
        }
      }

      return 'Unable to fetch contribution data.';
    };

    const renderGrid = (container: HTMLElement, data: ContributionData): void => {
      container.style.setProperty('--week-count', String(data.weeks.length));
      container.replaceChildren();

      data.weeks.forEach((week) => {
        const weekElement = document.createElement('div');
        weekElement.className = 'contribution-week';

        week.contribution_days.forEach((day) => {
          const dayElement = document.createElement('span');
          dayElement.className = 'contribution-day';
          dayElement.dataset.level = String(Math.max(0, Math.min(4, day.level)));
          dayElement.title = `${day.count} contributions`;
          dayElement.setAttribute('aria-label', `${day.count} contributions`);
          weekElement.append(dayElement);
        });

        container.append(weekElement);
      });
    };

    const renderResult = (
      card: Element | null,
      username: string,
      data: ContributionData,
      isWinner: boolean,
    ): void => {
      if (!(card instanceof HTMLElement)) {
        return;
      }

      const heading = card.querySelector('h3');
      const total = card.querySelector('.total');
      const dateRange = card.querySelector('.date-range');
      const graph = card.querySelector('.contribution-grid');

      if (heading instanceof HTMLElement) {
        heading.textContent = username;
      }

      if (total instanceof HTMLElement) {
        total.textContent = data.total_contributions.toLocaleString();
      }

      if (dateRange instanceof HTMLElement) {
        dateRange.textContent = `${formatDate(data.from)} – ${formatDate(data.to)}`;
      }

      if (graph instanceof HTMLElement) {
        renderGrid(graph, data);
      }

      contributionDataByCard.set(card, data);
      card.classList.toggle('winner', isWinner);
    };

    const toggleContributionGrid = (card: HTMLElement): void => {
      const graph = card.querySelector('.contribution-grid');
      const data = contributionDataByCard.get(card);

      if (graph instanceof HTMLElement && data && graph.childElementCount === 0) {
        renderGrid(graph, data);
      }

      card.classList.toggle('card-flipped');
    };

    document.querySelectorAll('.result-card').forEach((card) => {
      if (!(card instanceof HTMLElement)) {
        return;
      }

      card.addEventListener('click', () => toggleContributionGrid(card));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const usernames = [
        String(formData.get('playerOne') ?? '').trim(),
        String(formData.get('playerTwo') ?? '').trim(),
      ];

      if (usernames.some((username) => username.length === 0)) {
        status.textContent = 'Enter a GitHub username for both players.';
        status.className = 'status error';
        results.hidden = true;
        return;
      }

      button.disabled = true;
      status.textContent = 'Fetching contribution totals...';
      status.className = 'status loading';
      results.hidden = true;
      document.querySelectorAll('.result-card').forEach((card) => {
        if (!(card instanceof HTMLElement)) {
          return;
        }

        card.classList.remove('card-flipped');
      });

      try {
        const responses = await Promise.all(
          usernames.map((username) =>
            fetch(`/api/contributions/${encodeURIComponent(username)}`).then(async (response) => {
              const data: unknown = await response.json();

              if (!response.ok) {
                throw new Error(getApiError(data));
              }

              if (!isContributionData(data)) {
                throw new Error('GitHub returned an unexpected contribution response.');
              }

              return data;
            }),
          ),
        );
        const resultCards = [
          document.querySelector('#player-one-result'),
          document.querySelector('#player-two-result'),
        ];
        const totals = responses.map((data) => data.total_contributions);
        const highestTotal = Math.max(...totals);

        resultCards.forEach((card, index) =>
          renderResult(card, usernames[index], responses[index], totals[index] === highestTotal),
        );

        if (totals[0] === totals[1]) {
          winner.textContent = 'It’s a tie!';
        } else {
          const winnerIndex = totals[0] > totals[1] ? 0 : 1;
          winner.textContent = `${usernames[winnerIndex]} wins!`;
        }

        results.hidden = false;
        status.className = 'status';
        status.textContent = 'Battle complete.';
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : 'Unable to complete the battle.';
        status.className = 'status error';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
